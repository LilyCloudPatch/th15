{
  "schema": "lilypatch.text.v1",
  "target_id": "th15_100b",
  "resource": "data/st04d.msg",
  "entries": {
    "text-000": {
      "original_lines": [
        "これは一体！？"
      ],
      "translated_lines": [
        "这究竟怎么了！？"
      ]
    },
    "text-001": {
      "original_lines": [
        "何故こんなに冷え切っているのかしら"
      ],
      "translated_lines": [
        "为什么会有这样刺骨的寒气啊"
      ]
    },
    "text-002": {
      "original_lines": [
        "それに誰もいないだなんて……"
      ],
      "translated_lines": [
        "而且怎么一个人也没有……"
      ]
    },
    "text-003": {
      "original_lines": [
        "あ、サグメ様……",
        "この現状は一体"
      ],
      "translated_lines": [
        "啊，探女大人……",
        "这个状况究竟是"
      ]
    },
    "text-004": {
      "original_lines": [
        "……兎？"
      ],
      "translated_lines": [
        "……兔子？"
      ]
    },
    "text-005": {
      "original_lines": [
        "今、月の民は全員仮の月の都に",
        "退避している筈なのに"
      ],
      "translated_lines": [
        "现在，月之民全员应该都退避到",
        "虚假的月之都去了才对啊"
      ]
    },
    "text-006": {
      "original_lines": [
        "仮の……月の都？"
      ],
      "translated_lines": [
        "虚假的……月之都？"
      ]
    },
    "text-007": {
      "original_lines": [
        "もしかしてみんな",
        "夢の世界にいるとか"
      ],
      "translated_lines": [
        "莫非大家都在",
        "梦境之类的地方吗"
      ]
    },
    "text-008": {
      "original_lines": [
        "察しが良いわね"
      ],
      "translated_lines": [
        "你悟性挺高呢"
      ]
    },
    "text-009": {
      "original_lines": [
        "月の民はみな夢の世界を",
        "本物の都と勘違いしている"
      ],
      "translated_lines": [
        "月之民全员都把梦境",
        "误认为真正的月之都了"
      ]
    },
    "text-010": {
      "original_lines": [
        "それこそ月の都の狂夢"
      ],
      "translated_lines": [
        "那才是月之都的狂梦"
      ]
    },
    "text-011": {
      "original_lines": [
        "いつも喋らないサグメ様が",
        "饒舌になっているなんて"
      ],
      "translated_lines": [
        "一直沉默寡言的探女大人",
        "居然变得喋喋不休"
      ]
    },
    "text-012": {
      "original_lines": [
        "何か本当におかしな事が",
        "起きているんだわ"
      ],
      "translated_lines": [
        "总觉得确实发生了",
        "什么可疑的事件呢"
      ]
    },
    "text-013": {
      "original_lines": [
        "貴方は地上に堕ちた兎ね",
        "八意様のところの"
      ],
      "translated_lines": [
        "你是堕落到地上的兔子呢",
        "在八意大人那儿的那只"
      ]
    },
    "text-014": {
      "original_lines": [
        "まさか獏がこちらへ通すとは",
        "思わなかったけど……"
      ],
      "translated_lines": [
        "虽然我真没想到那只貘",
        "居然放你到这里来了……"
      ]
    },
    "text-015": {
      "original_lines": [
        "|88,16,・・・",
        "もしかして可能性が",
        "あるというのか……"
      ],
      "translated_lines": [
        "莫非她认为你拥有",
        "|40,16,···",
        "这个可能性吗……"
      ]
    },
    "text-016": {
      "original_lines": [
        "試してみるわ",
        "地上に堕ちた貴方の力を！"
      ],
      "translated_lines": [
        "让我试炼一下吧",
        "堕落到地上的你的力量！"
      ]
    },
    "text-017": {
      "original_lines": [
        "判った判った",
        "もう十分よ"
      ],
      "translated_lines": [
        "明白了明白了",
        "这已经足够了"
      ]
    },
    "text-018": {
      "original_lines": [
        "八意様が貴方を遣った",
        "理由が判ったわ"
      ],
      "translated_lines": [
        "我已经明白八意大人",
        "派遣你过来的理由了"
      ]
    },
    "text-019": {
      "original_lines": [
        "貴方なら月の都を",
        "救えるかも知れない"
      ],
      "translated_lines": [
        "如果是你的话",
        "也许就能拯救月之都"
      ]
    },
    "text-020": {
      "original_lines": [
        "えええ？",
        "月の都をー？"
      ],
      "translated_lines": [
        "咦咦咦？",
        "能什么月之都？"
      ]
    },
    "text-021": {
      "original_lines": [
        "今、月の都はある敵によって",
        "侵略されようとしている"
      ],
      "translated_lines": [
        "现在，月之都正在遭受",
        "某个敌人的侵略"
      ]
    },
    "text-022": {
      "original_lines": [
        "侵略だって？"
      ],
      "translated_lines": [
        "侵略？"
      ]
    },
    "text-023": {
      "original_lines": [
        "それも我々月の民には",
        "手が出せない生命の力でね"
      ],
      "translated_lines": [
        "而且敌人操纵着令我等月之民",
        "无法出手抵抗的生命之力"
      ]
    },
    "text-024": {
      "original_lines": [
        "慌てて月の都を凍結停止させて",
        "全員を退避したけど"
      ],
      "translated_lines": [
        "虽然手忙脚乱地冻结了月之都",
        "让全员退避到了梦境"
      ]
    },
    "text-025": {
      "original_lines": [
        "このままでは狂夢によって",
        "月の民の精神も持たない"
      ],
      "translated_lines": [
        "但就这样生活在狂梦之中",
        "月之民的精神也无法支撑下去"
      ]
    },
    "text-026": {
      "original_lines": [
        "だから早いうちに",
        "幻想郷へ遷都しようと考えていたの"
      ],
      "translated_lines": [
        "所以我们在考虑",
        "尽快迁都到幻想乡去"
      ]
    },
    "text-027": {
      "original_lines": [
        "うひょっ！？",
        "遷都！？"
      ],
      "translated_lines": [
        "真假！？",
        "迁都！？"
      ]
    },
    "text-028": {
      "original_lines": [
        "いやー、驚きすぎました",
        "その事は地上に来ている月の兎は……"
      ],
      "translated_lines": [
        "啊呀，太过震惊了",
        "那种事，到地上来的月兔可……"
      ]
    },
    "text-029": {
      "original_lines": [
        "勿論知らないわ"
      ],
      "translated_lines": [
        "她们当然不知道"
      ]
    },
    "text-030": {
      "original_lines": [
        "地上に月の都の別荘を作ろう",
        "程度にしか教えていない"
      ],
      "translated_lines": [
        "我只告诉了她们",
        "去在地上建立月之都的别墅而已"
      ]
    },
    "text-031": {
      "original_lines": [
        "……月の民の上司はいつもそう",
        "隠蔽に隠蔽でもう嫌になっちゃう"
      ],
      "translated_lines": [
        "……月之民的上司一直都是这样",
        "什么都非要讳莫如深，我已经受够了"
      ]
    },
    "text-032": {
      "original_lines": [
        "でもなんでそれを私に？"
      ],
      "translated_lines": [
        "但是为什么会把这些告诉我？ "
      ]
    },
    "text-033": {
      "original_lines": [
        "貴方に教えたのは",
        "貴方が敵を討つ条件を満たしていたからよ"
      ],
      "translated_lines": [
        "我把真相告诉你",
        "是因为你能够满足出手讨伐敌人的条件"
      ]
    },
    "text-034": {
      "original_lines": [
        "敵は生命の源を牛耳る力を",
        "持っています"
      ],
      "translated_lines": [
        "敌人拥有能够操纵",
        "生命之源的力量"
      ]
    },
    "text-035": {
      "original_lines": [
        "|118,12,われわれ",
        "生死を拒絶する月の民を",
        "逆手にとった狡い敵なのですが……"
      ],
      "translated_lines": [
        "|91,21,我等",
        "完全利用了月之民拒绝生与死的弱点",
        "是个相当狡诈的敌人……"
      ]
    },
    "text-036": {
      "original_lines": [
        "貴方はもう生死を拒絶しないのね",
        "身も心も地上に堕ちていた"
      ],
      "translated_lines": [
        "不过你已经不会拒绝生死了呢",
        "你的全身全心都已经堕落到地上去了"
      ]
    },
    "text-037": {
      "original_lines": [
        "貴方はもう穢れている",
        "だから貴方なら敵のところに行ける"
      ],
      "translated_lines": [
        "你已经沾染了污秽",
        "所以你能够接近敌人"
      ]
    },
    "text-038": {
      "original_lines": [
        "ふー恐ろしい話",
        "有難うございました"
      ],
      "translated_lines": [
        "呼——真是惊人的事实",
        "告诉我这么多非常感谢"
      ]
    },
    "text-039": {
      "original_lines": [
        "永琳様も輝夜様も、最初から判って",
        "私や人間に行かせようとしたんだわ"
      ],
      "translated_lines": [
        "永琳大人也是辉夜大人也是，一早就心知肚明",
        "还把我和人类指派过来"
      ]
    },
    "text-040": {
      "original_lines": [
        "人の危険なんて",
        "どうでも良いのよね"
      ],
      "translated_lines": [
        "即使我们身陷险境",
        "她们反正也无所谓啦"
      ]
    },
    "text-041": {
      "original_lines": [
        "私が計画を話してしまったので",
        "もう幻想郷に遷都は出来ないでしょう"
      ],
      "translated_lines": [
        "因为我说出了这个计划",
        "所以迁都到幻想乡已经不可能实现了吧"
      ]
    },
    "text-042": {
      "original_lines": [
        "だからもう貴方しか頼りが無いの",
        "判るでしょ？"
      ],
      "translated_lines": [
        "所以现在只有依靠你这一条路了",
        "你也明白吧？"
      ]
    },
    "text-043": {
      "original_lines": [
        "はあ、サグメ様がそう仰るのなら",
        "そういう事になっちゃうんでしょうね"
      ],
      "translated_lines": [
        "哈啊，既然探女大人都这么说了",
        "那我也只能帮忙了吧"
      ]
    },
    "text-044": {
      "original_lines": [
        "強制的に"
      ],
      "translated_lines": [
        "强迫性的"
      ]
    },
    "text-045": {
      "original_lines": [
        "判っているのなら行きなさい！",
        "いざ敵の本拠地、静かの海に向かえ！"
      ],
      "translated_lines": [
        "明白的话就出发吧！",
        "向敌人的根据地，静海进发吧！"
      ]
    },
    "text-046": {
      "original_lines": [
        "これはいわば勅命よ",
        "私の天津神部分からの……"
      ],
      "translated_lines": [
        "这可以算是敕命哦",
        "由我以天津神的身份所下的敕命…… "
      ]
    }
  }
}
