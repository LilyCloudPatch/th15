{
  "schema": "lilypatch.text.v1",
  "target_id": "th15_100b",
  "resource": "data/st06d.msg",
  "entries": {
    "text-000": {
      "original_lines": [
        "万策尽きて暴挙に出たとでも",
        "言うのだろうか"
      ],
      "translated_lines": [
        "这种情况应该称之为",
        "无计可施反而慌不择路了吧"
      ]
    },
    "text-001": {
      "original_lines": [
        "月の民のその様な姿を",
        "見たくは無かったですね"
      ],
      "translated_lines": [
        "这种样子的月之民",
        "之前完全没有见过呢"
      ]
    },
    "text-002": {
      "original_lines": [
        "……誰？"
      ],
      "translated_lines": [
        "……谁？"
      ]
    },
    "text-003": {
      "original_lines": [
        "私の名は純狐"
      ],
      "translated_lines": [
        "我的名字是纯狐"
      ]
    },
    "text-004": {
      "original_lines": [
        "月の民に仇なす仙霊である"
      ],
      "translated_lines": [
        "乃与月之民敌对的仙灵"
      ]
    },
    "text-005": {
      "original_lines": [
        "月の民にこんな敵がいたなんて",
        "聞いてないわ！"
      ],
      "translated_lines": [
        "我之前从未听说过",
        "月之民有这种敌人存在！"
      ]
    },
    "text-006": {
      "original_lines": [
        "|56,16,せんし",
        "まさか月の兎を送り込んでくるなんて"
      ],
      "translated_lines": [
        "|105,28,战士",
        "没想到还会把月之兔送到这里来"
      ]
    },
    "text-007": {
      "original_lines": [
        "狂気の民が正気に堕ちたのかな"
      ],
      "translated_lines": [
        "狂气之民也堕落到正常状态了吗"
      ]
    },
    "text-008": {
      "original_lines": [
        "|101,10,しごと",
        "さあね、私も命令で来ただけだから",
        "何が狂気で何が正気か良く判らない"
      ],
      "translated_lines": [
        "|183,13,工作",
        "那不好说，我也只是因为命令才到这里来而已",
        "什么是狂气什么是正常我也不明白"
      ]
    },
    "text-009": {
      "original_lines": [
        "ただこれだけは言える！"
      ],
      "translated_lines": [
        "但是只有一点我可以说清楚！"
      ]
    },
    "text-010": {
      "original_lines": [
        "月の民は狂気のままだ！",
        "まごう事なき狂気、絶対の狂気！"
      ],
      "translated_lines": [
        "月之民依然是狂气的！",
        "毫无疑问的狂气，绝对的狂气！"
      ]
    },
    "text-011": {
      "original_lines": [
        "そうじゃなきゃ、こんな仕事",
        "振るわけが無いもん"
      ],
      "translated_lines": [
        "不然的话，我也不会",
        "接下这种差事了"
      ]
    },
    "text-012": {
      "original_lines": [
        "ほう……そこまで言うのなら",
        "お前には秘密があるというのです？"
      ],
      "translated_lines": [
        "哦……既然你都说到这份上了",
        "你身上应该藏着什么秘密吧？"
      ]
    },
    "text-013": {
      "original_lines": [
        "私に気付いていない月の秘策が"
      ],
      "translated_lines": [
        "某个我没注意到的月之民的秘策"
      ]
    },
    "text-014": {
      "original_lines": [
        "さあね"
      ],
      "translated_lines": [
        "天知道"
      ]
    },
    "text-015": {
      "original_lines": [
        "でも気を付けた方が良いのは",
        "貴方よ"
      ],
      "translated_lines": [
        "但是小心一点为好的",
        "应该是你哦"
      ]
    },
    "text-016": {
      "original_lines": [
        "私はサグメ様の命でここに居る"
      ],
      "translated_lines": [
        "我是奉探女大人之命才到这儿来"
      ]
    },
    "text-017": {
      "original_lines": [
        "運命は逆転し始めているのよ！"
      ],
      "translated_lines": [
        "就要在此逆天改命！"
      ]
    },
    "text-018": {
      "original_lines": [
        "面白い……月の民が私を厭わない",
        "と言うのならかかって来なさい"
      ],
      "translated_lines": [
        "有趣……只要你们月之民不介意的话",
        "就尽管放马过来吧"
      ]
    },
    "text-019": {
      "original_lines": [
        "月の兎に何が出来るのか",
        "月の民は何を考えているのか"
      ],
      "translated_lines": [
        "月之兔能有什么作为",
        "月之民在想着什么计策"
      ]
    },
    "text-020": {
      "original_lines": [
        "見せよ！",
        "穢れた月の民の成れの果てを！"
      ],
      "translated_lines": [
        "让我见识一下吧！",
        "污秽的月之民所能达成的结果！"
      ]
    },
    "text-021": {
      "original_lines": [
        "そして見よ！",
        "|69,10,かあい",
        "純粋なる瑕穢の向こう側を！"
      ],
      "translated_lines": [
        "你也见识一下吧！",
        "|69,10,",
        "纯粹的污秽的另一侧！"
      ]
    },
    "text-022": {
      "original_lines": [
        "万策尽きて暴挙に出たとでも",
        "言うのだろうか"
      ],
      "translated_lines": [
        "这种情况应该称之为",
        "无计可施反而慌不择路了吧"
      ]
    },
    "text-023": {
      "original_lines": [
        "月の民のその様な姿を",
        "見たくは無かったですね"
      ],
      "translated_lines": [
        "这种样子的月之民",
        "之前完全没有见过呢"
      ]
    },
    "text-024": {
      "original_lines": [
        "……誰？"
      ],
      "translated_lines": [
        "……谁？"
      ]
    },
    "text-025": {
      "original_lines": [
        "私の名は純狐"
      ],
      "translated_lines": [
        "我的名字是纯狐"
      ]
    },
    "text-026": {
      "original_lines": [
        "月の民に仇なす仙霊である"
      ],
      "translated_lines": [
        "乃与月之民敌对的仙灵"
      ]
    },
    "text-027": {
      "original_lines": [
        "月の民にこんな敵がいたなんて",
        "聞いてないわ！"
      ],
      "translated_lines": [
        "我之前从未听说过",
        "月之民有这种敌人存在！"
      ]
    },
    "text-028": {
      "original_lines": [
        "|56,16,せんし",
        "まさか月の兎を送り込んでくるなんて……",
        "ん？"
      ],
      "translated_lines": [
        "|105,28,战士",
        "没想到还会把月之兔送到这里来……",
        "嗯？"
      ]
    },
    "text-029": {
      "original_lines": [
        "どういうこと？",
        "何故お前はそこまで穢れている？"
      ],
      "translated_lines": [
        "怎么回事？",
        "为什么你会如此的污秽？"
      ]
    },
    "text-030": {
      "original_lines": [
        "何故お前はそこまでミスを",
        "受け入れているのです？"
      ],
      "translated_lines": [
        "为什么反而是你",
        "承受了这么多的miss？"
      ]
    },
    "text-031": {
      "original_lines": [
        "ああ、ミスを受け入れている",
        "訳じゃ無いけど……"
      ],
      "translated_lines": [
        "啊，也不能说是",
        "我承受了miss……"
      ]
    },
    "text-032": {
      "original_lines": [
        "私はもう月の兎を止めたんだ",
        "今はもう地上の兎なのよ"
      ],
      "translated_lines": [
        "我已经放弃了月之兔的身份",
        "现在已经是地上的兔子了"
      ]
    },
    "text-033": {
      "original_lines": [
        "な、何だって？",
        "そんな月の民に奇策が……"
      ],
      "translated_lines": [
        "你，你说什么？",
        "月之民竟然会用上这种奇策……"
      ]
    },
    "text-034": {
      "original_lines": [
        "月の兎を地上に堕として",
        "私にぶつけるだなんて"
      ],
      "translated_lines": [
        "把月之兔丢到地上",
        "再让她来攻击我"
      ]
    },
    "text-035": {
      "original_lines": [
        "素直に感心したわ！"
      ],
      "translated_lines": [
        "实在是佩服！"
      ]
    },
    "text-036": {
      "original_lines": [
        "え、あ、そうなの？"
      ],
      "translated_lines": [
        "诶，啊，这样啊？"
      ]
    },
    "text-037": {
      "original_lines": [
        "でも奇策は奇策",
        "月の民も愚かなミスをしている"
      ],
      "translated_lines": [
        "但是奇策归奇策",
        "月之民还是犯下了愚蠢的失误"
      ]
    },
    "text-038": {
      "original_lines": [
        "この地上の兎は必要以上に",
        "穢れを負っているわ"
      ],
      "translated_lines": [
        "这只地上的兔子",
        "背负了太多的污秽"
      ]
    },
    "text-039": {
      "original_lines": [
        "これでは私の力の前では無力！",
        "絶対的無力！"
      ],
      "translated_lines": [
        "这么一来在我的力量面前就没用了！",
        "绝对的没用！"
      ]
    },
    "text-040": {
      "original_lines": [
        "|164,8,じょうが",
        "だが、不倶戴天の敵、嫦娥よ",
        "見ているか？"
      ],
      "translated_lines": [
        "|164,8,",
        "但是，不共戴天之敌，嫦娥啊",
        "你在看着吗？"
      ]
    },
    "text-041": {
      "original_lines": [
        "お前が出てくるまで",
        "こいつをいたぶり続けよう！"
      ],
      "translated_lines": [
        "我会一直折磨这家伙",
        "直到你现身为止！"
      ]
    }
  }
}
