{
  "schema": "lilypatch.text.v1",
  "target_id": "th15_100b",
  "resource": "data/st01c.msg",
  "entries": {
    "text-000": {
      "original_lines": [
        "確かこの辺にあったのよ",
        "探査機みたいなのが"
      ],
      "translated_lines": [
        "确实就在这附近来着",
        "有个像探测器的东西"
      ]
    },
    "text-001": {
      "original_lines": [
        "ためらいなく",
        "撃つぞ！"
      ],
      "translated_lines": [
        "我要毫不犹豫地",
        "打你了！"
      ]
    },
    "text-002": {
      "original_lines": [
        "『こちら清蘭",
        "　好戦的な地上人と接触した』"
      ],
      "translated_lines": [
        "『这里是清兰",
        "　与好战的地上人产生了接触』"
      ]
    },
    "text-003": {
      "original_lines": [
        "『これから浄化活動に入る』"
      ],
      "translated_lines": [
        "『现在开始执行净化行动』"
      ]
    },
    "text-004": {
      "original_lines": [
        "んー？",
        "その耳……兎なの？"
      ],
      "translated_lines": [
        "嗯？",
        "那对耳朵……兔子？"
      ]
    },
    "text-005": {
      "original_lines": [
        "|116,9,イーグルラヴィ",
        "我々は月の兎の調査部隊"
      ],
      "translated_lines": [
        "|102,10,Eagle Rabbit",
        "我们是月兔的调查部队"
      ]
    },
    "text-006": {
      "original_lines": [
        "邪魔する者は消滅せよ！"
      ],
      "translated_lines": [
        "碍事的人都消灭吧！"
      ]
    },
    "text-007": {
      "original_lines": [
        "やだー",
        "何で援軍が誰も来ないのよー"
      ],
      "translated_lines": [
        "讨厌—",
        "为什么援军谁都不过来啊—"
      ]
    },
    "text-008": {
      "original_lines": [
        "これだから今の兎は命令を守らない屑だ",
        "って言われるのよー"
      ],
      "translated_lines": [
        "正因为这样当今的兔子",
        "才会被人说成是不听命令的渣滓—"
      ]
    },
    "text-009": {
      "original_lines": [
        "そういえばこの辺で探査……",
        "機械の蜘蛛っぽいの見ませんでした？"
      ],
      "translated_lines": [
        "说起来您有没有在这附近见到探测……",
        "一个机器蜘蛛一样的东西？"
      ]
    },
    "text-010": {
      "original_lines": [
        "地上探査機の事ですかね",
        "それなら今は基地に帰っていますよー"
      ],
      "translated_lines": [
        "你是指地面探测器吗",
        "那个现在已经回基地了"
      ]
    },
    "text-011": {
      "original_lines": [
        "ってそんな事私が言ったなんて",
        "みんなには内緒だよ！"
      ],
      "translated_lines": [
        "等下，不要跟别人说",
        "是我说的！"
      ]
    },
    "text-012": {
      "original_lines": [
        "はあはあ、じゃあ内緒ついでに",
        "基地の場所も教えて頂けないかと……"
      ],
      "translated_lines": [
        "是吗是吗，我不会跟人说的",
        "所以能不能顺便告诉我一下基地的位置……"
      ]
    }
  }
}
