{
  "schema": "lilypatch.text.v1",
  "target_id": "th15_100b",
  "resource": "data/st02c.msg",
  "entries": {
    "text-000": {
      "original_lines": [
        "こんなに家の近くに基地が",
        "あったなんて盲点でした"
      ],
      "translated_lines": [
        "基地居然离家这么近",
        "真是盲点"
      ]
    },
    "text-001": {
      "original_lines": [
        "お待ちしておりましたー"
      ],
      "translated_lines": [
        "我等了好久了—"
      ]
    },
    "text-002": {
      "original_lines": [
        "清蘭から話を聞いたわ",
        "面白い奴と交戦したって……"
      ],
      "translated_lines": [
        "我从清兰那里听说了",
        "说是和一个有趣的家伙交战了……"
      ]
    },
    "text-003": {
      "original_lines": [
        "ここの湖はうちの管理区域なの"
      ],
      "translated_lines": [
        "这个湖是我家的管理区域"
      ]
    },
    "text-004": {
      "original_lines": [
        "勝手なことしないでくれる？"
      ],
      "translated_lines": [
        "能不能不要乱搞？"
      ]
    },
    "text-005": {
      "original_lines": [
        "貴方、私達が何者なのか",
        "判っているの？"
      ],
      "translated_lines": [
        "你，知道我们到底是",
        "什么人吗？"
      ]
    },
    "text-006": {
      "original_lines": [
        "|116,9,イーグルラヴィ",
        "私達は月の兎の調査部隊"
      ],
      "translated_lines": [
        "|102,10,Eagle Rabbit",
        "我们是月兔的调查部队"
      ]
    },
    "text-007": {
      "original_lines": [
        "穢れた地上の指図など",
        "受けないわ"
      ],
      "translated_lines": [
        "不会接受",
        "来自污秽的地面的指示"
      ]
    },
    "text-008": {
      "original_lines": [
        "へーやるじゃん",
        "強いわね"
      ],
      "translated_lines": [
        "哎哟挺厉害啊",
        "真强"
      ]
    },
    "text-009": {
      "original_lines": [
        "月の兎……"
      ],
      "translated_lines": [
        "月兔……"
      ]
    },
    "text-010": {
      "original_lines": [
        "永遠亭のお仲間ね"
      ],
      "translated_lines": [
        "是永远亭的伙伴吧"
      ]
    },
    "text-011": {
      "original_lines": [
        "私達は現役の兎兵士であり",
        "残念ながら彼女らは敵なのよ"
      ],
      "translated_lines": [
        "我们是现役的月兔士兵",
        "很可惜她们是我们的敌人"
      ]
    },
    "text-012": {
      "original_lines": [
        "うーん……",
        "するってぇと"
      ],
      "translated_lines": [
        "嗯……",
        "也就是说"
      ]
    },
    "text-013": {
      "original_lines": [
        "私にとって貴方達は",
        "敵なのね？"
      ],
      "translated_lines": [
        "你们对于我来说",
        "是敌人吧？"
      ]
    },
    "text-014": {
      "original_lines": [
        "敵では無い",
        "味方ですら無い"
      ],
      "translated_lines": [
        "并不是敌人",
        "亦不是朋友"
      ]
    },
    "text-015": {
      "original_lines": [
        "地上人は浄化の過程において",
        "非常に良い働きをしてくれた"
      ],
      "translated_lines": [
        "地上人在净化的过程中",
        "起到了非常好的作用"
      ]
    },
    "text-016": {
      "original_lines": [
        "……らしいよ",
        "|56,16,うさぎ",
        "うちら下っ端にはよく判らないけど"
      ],
      "translated_lines": [
        "……据说如此",
        "|43,19,兔子",
        "我们小角色也搞不懂"
      ]
    },
    "text-017": {
      "original_lines": [
        "よく判らない……ね"
      ],
      "translated_lines": [
        "搞不懂……吗"
      ]
    },
    "text-018": {
      "original_lines": [
        "さあどうする？"
      ],
      "translated_lines": [
        "那你打算怎么办？"
      ]
    },
    "text-019": {
      "original_lines": [
        "貴方が望むなら",
        "この先に進んでも良いわよ"
      ],
      "translated_lines": [
        "你想的话",
        "你可以接着向前走"
      ]
    },
    "text-020": {
      "original_lines": [
        "|40,16,ここ",
        "私は地上が気に入ったので",
        "残るけどね"
      ],
      "translated_lines": [
        "|99,16,这里",
        "我倒是喜欢上地面了",
        "所以我要留下"
      ]
    }
  }
}
