{
  "schema": "lilypatch.text.v1",
  "target_id": "th15_100b",
  "resource": "data/st05d.msg",
  "entries": {
    "text-000": {
      "original_lines": [
        "都の外に妖精の大群……？"
      ],
      "translated_lines": [
        "月之都的外面有大群的妖精……？"
      ]
    },
    "text-001": {
      "original_lines": [
        "これがサグメ様の言っていた",
        "侵略者？"
      ],
      "translated_lines": [
        "这就是探女大人说的",
        "侵略者？"
      ]
    },
    "text-002": {
      "original_lines": [
        "いや、確かに妖精は穢れの象徴だけど",
        "あいつ等に侵略する知能は無いと思う"
      ],
      "translated_lines": [
        "不，虽然妖精确实是污秽的象征",
        "但那些家伙应该没有侵略的智商"
      ]
    },
    "text-003": {
      "original_lines": [
        "それに月の民だって妖精程度の",
        "穢れは怖くないし……"
      ],
      "translated_lines": [
        "而且月之民对于区区妖精程度的",
        "污秽也不会害怕的……"
      ]
    },
    "text-004": {
      "original_lines": [
        "って疑問はそこじゃないわ"
      ],
      "translated_lines": [
        "说来疑问才不是这里啊"
      ]
    },
    "text-005": {
      "original_lines": [
        "そもそもなんで月面に",
        "妖精がいるのか、ってとこよね"
      ],
      "translated_lines": [
        "说到底，为什么",
        "在月面上会有妖精呢"
      ]
    },
    "text-006": {
      "original_lines": [
        "それはねぇ"
      ],
      "translated_lines": [
        "这个啊"
      ]
    },
    "text-007": {
      "original_lines": [
        "地上から連れて来られた",
        "のもいるけど"
      ],
      "translated_lines": [
        "虽然有些确实是从",
        "地上带来的"
      ]
    },
    "text-008": {
      "original_lines": [
        "月面にも元々いたのよ、妖精は"
      ],
      "translated_lines": [
        "月面上本来就有的啊，妖精"
      ]
    },
    "text-009": {
      "original_lines": [
        "妖精の親玉ね"
      ],
      "translated_lines": [
        "妖精的老大是吧"
      ]
    },
    "text-010": {
      "original_lines": [
        "確かに他の妖精とはひと味違う",
        "ようだけど……"
      ],
      "translated_lines": [
        "和其他的妖精比起来好像确实",
        "不太一样……"
      ]
    },
    "text-011": {
      "original_lines": [
        "こんな奴に月の民が",
        "手を焼くなんて……"
      ],
      "translated_lines": [
        "月之民居然为了这些家伙",
        "而束手无策……"
      ]
    },
    "text-012": {
      "original_lines": [
        "あたいを誰だと思っているの"
      ],
      "translated_lines": [
        "你以为我是谁啊"
      ]
    },
    "text-013": {
      "original_lines": [
        "あたいは地獄の妖精",
        "クラウンピース"
      ],
      "translated_lines": [
        "我可是地狱的妖精",
        "克劳恩皮丝"
      ]
    },
    "text-014": {
      "original_lines": [
        "月の民は友人様の敵",
        "友人様の敵はご主人様の敵"
      ],
      "translated_lines": [
        "月之民是朋友大人的敌人",
        "朋友大人的敌人是主人的敌人"
      ]
    },
    "text-015": {
      "original_lines": [
        "ご主人様の敵はあたいの敵だ！",
        "容赦しないぞ"
      ],
      "translated_lines": [
        "主人的敌人就是我的敌人！",
        "绝不手软哦"
      ]
    },
    "text-016": {
      "original_lines": [
        "腑に落ちない処も在るけど……",
        "私も容赦しないよ！"
      ],
      "translated_lines": [
        "虽然有些地方让人很纳闷……",
        "我也不会手软的哦！"
      ]
    },
    "text-017": {
      "original_lines": [
        "|8,16,・・",
        "純化した妖精のエネルギーは",
        "鬼神を越えるって言われたもん"
      ],
      "translated_lines": [
        "|8,16,··",
        "纯化过的妖精的能量",
        "据说是能够超越鬼神的哦"
      ]
    },
    "text-018": {
      "original_lines": [
        "月の民の嫌う生死の穢れを",
        "たっぷり喰らって"
      ],
      "translated_lines": [
        "月之民所厌恶的生死的污秽",
        "你就好好尝尝吧"
      ]
    },
    "text-019": {
      "original_lines": [
        "初めての死で",
        "地獄に堕ちるがいい！"
      ],
      "translated_lines": [
        "随着第一次死亡",
        "坠入地狱吧！"
      ]
    },
    "text-020": {
      "original_lines": [
        "はあはあはあ"
      ],
      "translated_lines": [
        "哈…哈…哈…"
      ]
    },
    "text-021": {
      "original_lines": [
        "この圧倒的な力……",
        "普通の妖精ではない！？"
      ],
      "translated_lines": [
        "这压倒性的力量……",
        "难道不是普通的妖精吗！？"
      ]
    },
    "text-022": {
      "original_lines": [
        "な、なんで……？"
      ],
      "translated_lines": [
        "为，为什么……？"
      ]
    },
    "text-023": {
      "original_lines": [
        "生命の象徴である我々妖精族が",
        "ここを支配している限り"
      ],
      "translated_lines": [
        "我听说只要我等象征着生命的",
        "妖精族还支配着这里"
      ]
    },
    "text-024": {
      "original_lines": [
        "月の民は手も足も出せないって",
        "聞いたのに"
      ],
      "translated_lines": [
        "月之民就根本",
        "不可能会动手的啊"
      ]
    },
    "text-025": {
      "original_lines": [
        "ねえねえ、その話",
        "誰に聞いたの？"
      ],
      "translated_lines": [
        "喂喂，这些话",
        "是谁告诉你的？"
      ]
    },
    "text-026": {
      "original_lines": [
        "ご主人様の友人様よ"
      ],
      "translated_lines": [
        "主人的朋友大人啊"
      ]
    },
    "text-027": {
      "original_lines": [
        "|104,16,・・",
        "妖精達の力を純化してくれたのも",
        "そのお方"
      ],
      "translated_lines": [
        "|104,16,··",
        "把妖精的力量纯化的也是",
        "那位大人"
      ]
    },
    "text-028": {
      "original_lines": [
        "純化？",
        "それって一体……"
      ],
      "translated_lines": [
        "纯化？",
        "那个究竟是……"
      ]
    },
    "text-029": {
      "original_lines": [
        "あたいにも良く判らないけど",
        "凄いことらしいよ"
      ],
      "translated_lines": [
        "我虽然也不太明白不过",
        "好像很厉害哦"
      ]
    },
    "text-030": {
      "original_lines": [
        "ふーん、そいつが妖精達を",
        "騙して何かをしているのか"
      ],
      "translated_lines": [
        "哼——，那家伙",
        "欺骗妖精是在干嘛啊"
      ]
    },
    "text-031": {
      "original_lines": [
        "確かにここの妖精達は",
        "穢れまくっている"
      ],
      "translated_lines": [
        "虽然这里的妖精确实",
        "是污秽得不得了"
      ]
    },
    "text-032": {
      "original_lines": [
        "いや、穢れその物といってもいい",
        "レベルだわ"
      ],
      "translated_lines": [
        "不，已经直接说就是污秽本身",
        "也不为过"
      ]
    },
    "text-033": {
      "original_lines": [
        "確かにこのレベルで攻められると",
        "|36,8,しんわい",
        "都は榛穢化するかもしれないわね……"
      ],
      "translated_lines": [
        "确实要是有这种程度的攻击",
        "|36,8,",
        "月之都说不定也会荒芜化呢"
      ]
    },
    "text-034": {
      "original_lines": [
        "あのー、あんた、いや貴方様には何で",
        "私の穢れが平気だったのでしょう"
      ],
      "translated_lines": [
        "那个，你这家伙，不不阁下为什么",
        "对我的污秽完全没问题呢"
      ]
    },
    "text-035": {
      "original_lines": [
        "私はもう……、地上の兎だからね"
      ],
      "translated_lines": [
        "因为我是……，我是地上的兔子"
      ]
    },
    "text-036": {
      "original_lines": [
        "一度穢れてしまえば、もう戻る事は",
        "不可能でしょう"
      ],
      "translated_lines": [
        "要是沾染了污秽了，肯定是",
        "变不回去了吧"
      ]
    },
    "text-037": {
      "original_lines": [
        "でもこれで間違い無いわ"
      ],
      "translated_lines": [
        "不过肯定错不了了"
      ]
    },
    "text-038": {
      "original_lines": [
        "お師匠様は月の都を救うために",
        "私を遣ったんだわ"
      ],
      "translated_lines": [
        "师匠大人为了拯救月之都",
        "所以才派我的"
      ]
    },
    "text-039": {
      "original_lines": [
        "ただ、敵は月の民のクリティカルな弱点を",
        "熟知し、それを活かす能力を持っている"
      ],
      "translated_lines": [
        "不过，敌人深知月之民的致命弱点，",
        "还拥有能够强化并利用这一点的能力"
      ]
    },
    "text-040": {
      "original_lines": [
        "何者なのかしら……"
      ],
      "translated_lines": [
        "到底什么人啊…"
      ]
    },
    "text-041": {
      "original_lines": [
        "お師匠様もサグメ様も知っている筈なのに",
        "教えてくれないからなぁ"
      ],
      "translated_lines": [
        "师匠大人和探女大人应该都知道的",
        "会不会告诉我啊"
      ]
    },
    "text-042": {
      "original_lines": [
        "何にしてもここまで来たら",
        "最後までお師匠様の期待に添うのみよ！"
      ],
      "translated_lines": [
        "总之都已经到这一步了",
        "唯有依师匠大人所期待贯彻到底了！"
      ]
    },
    "text-043": {
      "original_lines": [
        "きゃはははは！",
        "面白い事が起こっているわー！"
      ],
      "translated_lines": [
        "呀啊啊啊啊！",
        "发生有趣的事情了！"
      ]
    },
    "text-044": {
      "original_lines": [
        "妖精達よ、もっとスピード",
        "あげていこうよ！"
      ],
      "translated_lines": [
        "妖精们啊",
        "速度快一点！"
      ]
    },
    "text-045": {
      "original_lines": [
        "イッツ、ルナティックターイム！",
        "　　狂気の世界へようこそ！"
      ],
      "translated_lines": [
        "　　　It's lunatic time!",
        "　　　欢迎来到狂野的世界！　　　"
      ]
    }
  }
}
