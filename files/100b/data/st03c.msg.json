{
  "schema": "lilypatch.text.v1",
  "target_id": "th15_100b",
  "resource": "data/st03c.msg",
  "entries": {
    "text-000": {
      "original_lines": [
        "|52,8,そら",
        "ああ、宙を飛んでいるわ",
        "今まさに飛んでいるわ"
      ],
      "translated_lines": [
        "|52,8,",
        "啊，我在宇宙中翱翔",
        "现在真的在翱翔"
      ]
    },
    "text-001": {
      "original_lines": [
        "あらあら"
      ],
      "translated_lines": [
        "哎呀哎呀"
      ]
    },
    "text-002": {
      "original_lines": [
        "随分と悪夢にうなされているみたいね",
        "私が食べてあげよう……って"
      ],
      "translated_lines": [
        "看起来被噩梦折磨得很惨呢",
        "我来帮着吃掉吧……等下"
      ]
    },
    "text-003": {
      "original_lines": [
        "生身じゃないの！？",
        "肉体付き悪夢！？"
      ],
      "translated_lines": [
        "这不是真身吗！？",
        "带着肉体的噩梦！？"
      ]
    },
    "text-004": {
      "original_lines": [
        "私は念願の宙を飛んでいるんです",
        "これが悪夢なら何が吉夢になるんです？"
      ],
      "translated_lines": [
        "我正如愿在宇宙中翱翔",
        "如果此乃噩梦，何为好梦？"
      ]
    },
    "text-005": {
      "original_lines": [
        "|53,11,スペースデブリ",
        "生身で悪夢の欠片に被弾すると",
        "大変な事になるわ"
      ],
      "translated_lines": [
        "|70,19,太空垃圾",
        "以真身被噩梦的碎片击中",
        "会出大事的"
      ]
    },
    "text-006": {
      "original_lines": [
        "今すぐ肉体だけでも",
        "|3,6,うつつ",
        "現に戻さないと"
      ],
      "translated_lines": [
        "需要尽快将肉体",
        "|3,6,",
        "送回现实才行"
      ]
    },
    "text-007": {
      "original_lines": [
        "えーっと、よく判らないんですが",
        "兎に月の都に行けるって言われたんで"
      ],
      "translated_lines": [
        "呃，我有点不太明白",
        "月兔告诉我能去月都"
      ]
    },
    "text-008": {
      "original_lines": [
        "月の都……",
        "ははぁんそういう事ね"
      ],
      "translated_lines": [
        "月都……",
        "呵呵这么回事啊"
      ]
    },
    "text-009": {
      "original_lines": [
        "良いでしょう",
        "その狂夢、私が処理しましょう"
      ],
      "translated_lines": [
        "很好",
        "那个狂梦，就请由我来处理吧"
      ]
    },
    "text-010": {
      "original_lines": [
        "今は眠りなさい",
        "|52,8,かいあん",
        "貴方の槐安は今作られる"
      ],
      "translated_lines": [
        "现在，睡吧",
        "|52,8,",
        "属于您的槐安，即将建成"
      ]
    },
    "text-011": {
      "original_lines": [
        "貴方の悪夢は私が",
        "美味しく頂きました"
      ],
      "translated_lines": [
        "您的噩梦已经被我",
        "美味地享用了"
      ]
    },
    "text-012": {
      "original_lines": [
        "ですがこのまま月の都に",
        "向かうというのなら"
      ],
      "translated_lines": [
        "但是如果您仍想以现在的样子",
        "前往月都的话"
      ]
    },
    "text-013": {
      "original_lines": [
        "今までの何倍もの悪夢となって",
        "貴方の精神を蝕むでしょう"
      ],
      "translated_lines": [
        "相较于迄今数倍的噩梦",
        "将会侵蚀您的精神"
      ]
    },
    "text-014": {
      "original_lines": [
        "月の狂夢（ルナティックドリーム）",
        "と呼ばれる悪夢です"
      ],
      "translated_lines": [
        "那是被称作",
        "月之狂梦（Lunatic Dream）的噩梦"
      ]
    },
    "text-015": {
      "original_lines": [
        "今ならまだ『目が覚めたら夢だった』",
        "って事にできますが……"
      ],
      "translated_lines": [
        "现在，您还能",
        "『醒过来发现只是梦而已』……"
      ]
    },
    "text-016": {
      "original_lines": [
        "それでも進みますか？"
      ],
      "translated_lines": [
        "即便如此您还要继续前进吗？"
      ]
    },
    "text-017": {
      "original_lines": [
        "私はその問いかけを知っている",
        "その答えを知っている"
      ],
      "translated_lines": [
        "我知道你的这个问题",
        "也知道问题的答案"
      ]
    },
    "text-018": {
      "original_lines": [
        "イイエを選んでも永遠に",
        "質問を繰り返す奴でしょう？"
      ],
      "translated_lines": [
        "即便我选了不",
        "你也会把这个问题永远重复下去吧？"
      ]
    },
    "text-019": {
      "original_lines": [
        "答えはイエス！",
        "このまま月の都に突入よ！"
      ],
      "translated_lines": [
        "答案是Yes！",
        "就这样直接冲进月都！"
      ]
    },
    "text-020": {
      "original_lines": [
        "そうですか……",
        "それでは貴方に吉夢が訪れん事を"
      ],
      "translated_lines": [
        "是吗……",
        "那么祝您能有一个好梦"
      ]
    },
    "text-021": {
      "original_lines": [
        "アポロ１７号が降り立ってから",
        "４０年以上成し得ていない有人探査"
      ],
      "translated_lines": [
        "自从阿波罗17号降落以后",
        "载人探测停滞了超过40年"
      ]
    },
    "text-022": {
      "original_lines": [
        "そのチャンスが目の前にあるというのに",
        "ここで夢オチにさせられてたまるもんですか！"
      ],
      "translated_lines": [
        "这样的机会明明就在眼前了",
        "怎么能甘心发现一切都是一场梦！"
      ]
    }
  }
}
